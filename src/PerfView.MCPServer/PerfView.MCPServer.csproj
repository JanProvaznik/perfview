<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <RootNamespace>PerfView.MCPServer</RootNamespace>
    <AssemblyName>PerfView.MCPServer</AssemblyName>
    <Description>PerfView Model Context Protocol Server - AI-accessible performance analysis</Description>
    <Company>Microsoft</Company>
    <Copyright>Copyright © Microsoft 2024</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <!-- Package versions are managed centrally in Directory.Packages.props -->
    <!-- ModelContextProtocol version: 0.4.0-preview.3 (preview package for MCP protocol support) -->
    <PackageReference Include="ModelContextProtocol" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TraceEvent\TraceEvent.csproj" />
    <ProjectReference Include="..\FastSerialization\FastSerialization.csproj" />
    <ProjectReference Include="..\MemoryGraph\MemoryGraph.csproj" />
  </ItemGroup>

  <!-- Copy TraceHelper executable to output directory after build -->
  <Target Name="CopyTraceHelper" AfterTargets="Build">
    <PropertyGroup>
      <HelperDir>$(MSBuildThisFileDirectory)..\PerfView.MCPServer.TraceHelper\bin\$(Configuration)\net8.0\</HelperDir>
      <HelperExe Condition="'$(OS)' == 'Windows_NT'">PerfView.MCPServer.TraceHelper.exe</HelperExe>
      <HelperExe Condition="'$(OS)' != 'Windows_NT'">PerfView.MCPServer.TraceHelper</HelperExe>
      <HelperSource>$(HelperDir)$(HelperExe)</HelperSource>
      <HelperDest>$(OutputPath)$(HelperExe)</HelperDest>
    </PropertyGroup>
    <Copy SourceFiles="$(HelperSource)" DestinationFiles="$(HelperDest)" Condition="Exists('$(HelperSource)')" />
    <Message Text="Copied TraceHelper ($(HelperExe)) to output directory" Condition="Exists('$(HelperSource)')" Importance="high" />
    <Warning Text="TraceHelper not found at $(HelperSource). Build PerfView.MCPServer.TraceHelper first." Condition="!Exists('$(HelperSource)')" />
  </Target>

</Project>
